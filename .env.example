# Bind address for the published port. Keep 127.0.0.1 for local-only access;
# set to 0.0.0.0 to allow other devices on your LAN to connect.
APP_BIND=127.0.0.1
APP_PORT=8080
DATA_DIR=./data
# Keep the default named volume, or replace with an absolute writable NAS path (e.g. /mnt/nas/wordwell-audio).
AUDIO_STORAGE_PATH=vocab-audio
WORDWELL_DOMAIN=study.example.com

# Persistent AI model storage: keep the default named volume or bind an absolute writable host/NAS path.
AI_MODEL_STORAGE_PATH=ai-models
# Internal local AI service. Models are preloaded at AI service startup and stay resident in memory.
AI_TEXT_PROVIDER=disabled
AI_TEXT_BASE_URL=http://ollama:11434/v1
AI_TEXT_MODEL=qwen2.5:3b
AI_TEXT_API_KEY=
ASR_MODEL=base.en

